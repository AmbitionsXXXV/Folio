{
  "extends": "@folionote/config/tsconfig.base.json",
  "compilerOptions": {
    "sourceMap": true,
    "noEmit": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", "__tests__"]
}
