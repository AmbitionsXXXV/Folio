{
  "extends": "@folionote/config/tsconfig.base.json",
  "compilerOptions": {
    "sourceMap": true,
    "noEmit": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./src/*"],
      "@folionote/api/__tests__/*": ["./__tests__/*"]
    }
  },
  "include": ["src/**/*.ts", "__tests__/**/*.ts"],
  "exclude": ["node_modules", "dist", "__tests__"]
}
