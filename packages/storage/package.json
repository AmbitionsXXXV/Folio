{
  "name": "@folionote/storage",
  "version": "0.2.8",
  "description": "FolioNote Storage client using S3 protocol",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "dotenv": "catalog:",
    "nanoid": "^5.1.6"
  },
  "devDependencies": {
    "@folionote/config": "workspace:*",
    "typescript": "catalog:"
  }
}
