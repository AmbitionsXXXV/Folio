BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# 支持多个 origin，用逗号分隔
# 例如: CORS_ORIGIN=https://folionote.xyz,https://www.folionote.xyz
# 本地开发环境 (localhost:*) 会自动允许
CORS_ORIGIN=

# ======================
# Database (Supabase in production\brew with pgsql server in development)
# ======================
# brew postgres server
# DATABASE_URL=postgresql://postgres:password@localhost:5432/folio_note
# supabase local server
DATABASE_URL=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RESEND_API_KEY=

# ======================
# Storage (S3 Protocol)
# ======================
# Supabase Storage S3 endpoint
# Local development: http://127.0.0.1:54321/storage/v1/s3
# Production: https://xxx.supabase.co/storage/v1/s3
S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3

# S3 Access Key - from `supabase status` output
S3_ACCESS_KEY=

# S3 Secret Key - from `supabase status` output
S3_SECRET_KEY=

# S3 Region (default: local)
S3_REGION=local

# Optional: Public URL base for file access
# Default is derived from S3_ENDPOINT
# S3_PUBLIC_URL=http://127.0.0.1:54321/storage/v1/object/public

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# https://www.weatherapi.com
WEATHER_API_KEY=

# Alpha Vantage
STOCK_API_KEY=

TAVILY_API_KEY=
