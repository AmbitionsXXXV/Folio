{
  "name": "folionote",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "bun tools/clean.js",
    "clean:all": "bun tools/clean.js && pnpm store prune",
    "check": "ultracite check",
    "check:fix": "ultracite fix",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "test:coverage": "turbo test:coverage",
    "test:server": "turbo -F server test",
    "test:api": "turbo -F @folionote/api test",
    "test:db": "turbo -F @folionote/db test",
    "check-keys": "turbo -F @folionote/locales check-keys",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "dev:ai-devtools": "pnpm -C apps/server dev:ai-devtools --",
    "db:push": "turbo -F @folionote/db db:push",
    "db:push:prod": "turbo -F @folionote/db db:push:prod",
    "db:studio": "turbo -F @folionote/db db:studio",
    "db:studio:prod": "turbo -F @folionote/db db:studio:prod",
    "db:generate": "turbo -F @folionote/db db:generate",
    "db:generate:prod": "turbo -F @folionote/db db:generate:prod",
    "db:migrate": "turbo -F @folionote/db db:migrate",
    "db:migrate:prod": "turbo -F @folionote/db db:migrate:prod",
    "db:start": "turbo -F @folionote/db db:start:supabase",
    "db:stop": "turbo -F @folionote/db db:stop:supabase",
    "db:start:supabase": "turbo -F @folionote/db db:start:supabase",
    "db:stop:supabase": "turbo -F @folionote/db db:stop:supabase",
    "db:status:supabase": "turbo -F @folionote/db db:status:supabase",
    "db:reset:supabase": "turbo -F @folionote/db db:reset:supabase",
    "db:start:docker": "turbo -F @folionote/db db:start:docker",
    "db:stop:docker": "turbo -F @folionote/db db:stop:docker",
    "db:init:local": "turbo -F @folionote/db db:init:local",
    "db:start:local": "turbo -F @folionote/db db:start:local",
    "db:stop:local": "turbo -F @folionote/db db:stop:local",
    "commit": "cz",
    "email:dev": "turbo -F @folionote/transactional dev",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version": "changeset version",
    "version:tag": "changeset version && changeset tag",
    "postinstall": "if [ -z \"$CI\" ]; then lefthook install; fi"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.41.6",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "cz-git": "^1.12.0",
    "fast-glob": "^3.3.3",
    "lefthook": "^2.1.1",
    "turbo": "^2.8.10",
    "typescript": "catalog:",
    "ultracite": "^7.2.3",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.30.2+sha512.36cdc707e7b7940a988c9c1ecf88d084f8514b5c3f085f53a2e244c2921d3b2545bc20dd4ebe1fc245feec463bb298aecea7a63ed1f7680b877dc6379d8d0cb4",
  "pnpm": {
    "overrides": {
      "drizzle-orm": "^0.45.1"
    }
  }
}
